{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CanonicalRequirementTarget",
  "type": "object",
  "required": [
    "requirement_id",
    "category",
    "field",
    "operator",
    "value",
    "unit",
    "period",
    "mandatory",
    "is_ambiguous"
  ],
  "properties": {
    "requirement_id": {
      "type": "string",
      "pattern": "^REQ_[0-9]{6}$"
    },
    "category": {
      "type": "string",
      "enum": [
        "financial",
        "tax_statutory",
        "msme",
        "experience",
        "technical",
        "certification",
        "oem",
        "local_content",
        "legal",
        "commercial",
        "delivery",
        "ambiguous"
      ]
    },
    "field": {
      "type": ["string", "null"]
    },
    "operator": {
      "type": ["string", "null"],
      "enum": ["==", "!=", ">", ">=", "<", "<=", "contains", "includes_all", "exists", null]
    },
    "value": {
      "type": ["number", "string", "boolean", "array", "null"]
    },
    "unit": {
      "type": ["string", "null"]
    },
    "period": {
      "type": ["string", "null"]
    },
    "mandatory": {
      "type": "boolean"
    },
    "is_ambiguous": {
      "type": "boolean"
    },
    "ambiguity_reason": {
      "type": ["string", "null"]
    }
  },
  "additionalProperties": false
}

