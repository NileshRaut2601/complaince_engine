# Neo4j Database Configuration for Tender Knowledge Graph
# Set these variables or create a .env file locally.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_secure_password_here
NEO4J_DATABASE=neo4j

# Data Paths (Defaults to project data/ directory)
TENDERS_DATA_PATH=data/tenders.json
GOVERNMENT_RECORDS_DATA_PATH=data/government_records.json

# Graph Importer Batch Settings
KG_BATCH_SIZE=100
KG_LOG_LEVEL=INFO

